# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development

# MongoDB Atlas connection string for THIS environment only.
# Dev branches should point at upcell_development, production (main branch / prod Render service)
# should point at upcell_production - never mix the two in one .env file.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

RESEND_KEY=
PORT=5001
CLERK_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
# Optional: comma-separated regex patterns for additional allowed CORS origins.
FRONTEND_ORIGIN_PATTERNS=
ADMIN_NOTIFICATION_EMAIL=

# Single sender identity for all outbound mail (wholesale, order, trade-in) —
# must use a domain verified in Resend, e.g. "UpCell <notifications@mail.upcellit.com>"
EMAIL_FROM=

# Bank of America — Secure Acceptance (Hosted Checkout). Generated in the
# merchant portal under Payment Acceptance Configuration > Secure Acceptance
# Settings > [profile] > Security. The secret key is shown once for 30 seconds
# at creation and cannot be retrieved again — if it's lost, delete the key and
# create a new one. Test and live keys come from separate portals and are never
# interchangeable.
BOA_ACCESS_KEY=
BOA_SECRET_KEY=
# Shown at the top of the profile page in the portal. The gateway uses it to
# resolve which profile a request belongs to — omit it and every request comes
# back as a 403 "you are not authorized to view this page".
BOA_PROFILE_ID=
# Test endpoint below; live is the same host without "test". Note the hyphen in
# "merchant-services" — "merchantservices" does not resolve to the gateway.
BOA_ENDPOINT=https://testsecureacceptance.merchant-services.bankofamerica.com/pay

TEST_SECRET=
TEST_ENDPOINTSECRET=whsec_placeholder

# Cloudinary — used for product image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
